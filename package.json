{
  "name": "kissan_mandi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:css && next dev",
    "build:css": "node node_modules/tailwindcss/lib/cli.js -i app/tailwind-input.css -o app/globals.css",
    "watch:css": "node node_modules/tailwindcss/lib/cli.js -i app/tailwind-input.css -o app/globals.css --watch",
    "build": "npm run build:css && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "autoprefixer": "^10.6.2",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "postcss": "^8.5.32",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
